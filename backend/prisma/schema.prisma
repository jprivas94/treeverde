generator client {
  provider        = "prisma-client-js"
  // rhel-openssl-3.0.x: runtime serverless de Vercel (Amazon Linux 2023,
  // OpenSSL 3). El target anterior (1.0.x) no existe en ese entorno y el
  // client crashearía en runtime al buscar su query engine.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  password         String
  profileImage     String?
  resetToken       String?        @unique
  resetTokenExpires DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tasks            Task[]
  createdTasks     Task[]         @relation("TaskCreator")
  sharedTasks      TaskShare[]
  notifications    Notification[]
  ownedBoards      Board[]
  boardMemberships BoardMember[]
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String      @default("")
  status      String      @default("TODO")
  priority    String      @default("MEDIUM")
  dueDate     DateTime?
  completedAt DateTime?
  archivedAt  DateTime?
  images      Json        @default("[]")
  tags        String      @default("")
  subtasks    Json        @default("[]")
  assigneeId  String?
  creatorId   String?
  boardId     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  // Enlace de invitación por URL: inviteToken (único) + rol con el que se agrega
  // al aceptarlo ('assignee' en la creación, 'share' en la edición).
  inviteToken String?     @unique
  inviteRole  String      @default("share")
  assignee    User?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User?       @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  board       Board?      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  shares      TaskShare[]
  notifications Notification[]

  // Índices para consultas frecuentes (listado por creador/asignado/tablero)
  @@index([creatorId])
  @@index([assigneeId])
  @@index([boardId])
}

// ─── Tableros: agrupan tareas. El dueño es quien las crea; los miembros
// (BoardMember) pueden ver el tablero y sus tareas.
model Board {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  color       String   @default("emerald")
  icon        String   @default("🗂")
  // Enlace de invitación al tablero: quien lo acepte queda como miembro
  // (puede ver/crear/editar tareas SOLO de este tablero).
  inviteToken String?  @unique
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members BoardMember[]
  tasks   Task[]

  @@index([ownerId])
}

// Membresía usuario ↔ tablero (incluye al dueño como 'owner').
model BoardMember {
  boardId   String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  taskId    String?
  type      String   @default("INFO")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, read])
}

model TaskShare {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  // Lookups por usuario (shares: { some: { userId } } en GET /api/tasks)
  @@index([userId])
}

