[TEMPLATE]
# PostgreSQL (producción):
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db"

# SQLite (desarrollo local):
# DATABASE_URL="file:./dev.db"

JWT_SECRET="mi-clave-secreta-123"
PORT=3001

# Cloudflare R2 (para subir imágenes de tareas)
# Cómo obtenerlas: https://dash.cloudflare.com > R2 > Crear bucket > Manage API Tokens
# R2_ACCOUNT_ID="tu-account-id"
# R2_ACCESS_KEY="tu-access-key"
# R2_SECRET_KEY="tu-secret-key"
# R2_BUCKET="treeverde-images"
# R2_PUBLIC_URL="https://images.tudominio.com"  # Opcional: dominio personalizado para imágenes públicas
