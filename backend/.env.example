
# ─── Base de Datos ──────────────────────────────────────────────────
# Desarrollo local (SQLite, viene por defecto):
DATABASE_URL="file:./dev.db"

# Producción (PostgreSQL en Supabase):
# DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:6543/postgres?pgbouncer=true"

# ─── Autenticación JWT ──────────────────────────────────────────────
# Cámbiala por una frase secreta larga y segura
JWT_SECRET="mi-clave-secreta-cambiar-en-produccion-123"

# ─── Puerto del Servidor ────────────────────────────────────────────
# Opcional. Por defecto usa 3001. Vercel ignora esto (usa su propio puerto).
PORT=3001

# ─── Cloudinary (Subida de Imágenes) ─────────────────────────────────
# Obtén estos valores en: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=tu_api_key_aqui
CLOUDINARY_API_SECRET=tu_api_secret_aqui

# ─── Entorno (Vercel lo setea automáticamente) ──────────────────────
# NODE_ENV=development | production
