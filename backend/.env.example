# ─── Base de Datos ──────────────────────────────────────────────────
# El provider de Prisma está fijado a PostgreSQL (ver schema.prisma).
DATABASE_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres?schema=public"

# ─── Autenticación JWT ──────────────────────────────────────────────
# OBLIGATORIA en producción: el backend LANZA UN ERROR si falta JWT_SECRET
# con NODE_ENV=production (sin fallback que permita forjar tokens).
# ¡Reemplaza este valor de muestra por una frase larga y aleatoria!
JWT_SECRET="mi-clave-secreta-cambiar-en-produccion-123"

# ─── Puerto del Servidor ────────────────────────────────────────────
# Opcional. Por defecto usa 3001. Vercel ignora esto (usa su propio puerto).
PORT=3001

# ─── Cloudinary (Subida de Imágenes) ─────────────────────────────────
# Obtén estos valores en: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=tu_api_key_aqui
CLOUDINARY_API_SECRET=tu_api_secret_aqui

# ─── URL del Frontend ───────────────────────────────────────────────
# Usada para: (1) generar el enlace de recuperación de contraseña y
# (2) restringir CORS a orígenes permitidos. Soporta varios orígenes
# separados por coma, ej: https://app.treeverde.app,https://preview.treeverde.app
FRONTEND_URL="http://localhost:5173"

# ─── Email de recuperación (Resend) ──────────────────────────────────
# Resend: crea una cuenta gratis en https://resend.com y genera una API key
# en https://resend.com/api-keys (plan gratis: 100 emails/día).
# Si se deja vacío, NO se envía el correo: en desarrollo el enlace de
# recuperación se devuelve en la respuesta de la API (y se loguea); en
# producción se loguea pero nunca se devuelve.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# Remitente: en el plan gratis usa tu email verificado en Resend
# (ej: "Treeverde <onboarding@resend.dev>" o tu dominio verificado).
EMAIL_FROM="Treeverde <onboarding@resend.dev>"

# ─── Realtime (Supabase) ─────────────────────────────────────────────
# JWT Secret del proyecto de Supabase (Dashboard → Project Settings → API).
# El backend lo usa para acuñar un JWT compatible con Supabase que autentica
# la conexión Realtime del frontend; así las políticas RLS evalúan auth.uid()
# y cada usuario solo recibe sus notificaciones/tareas (migración
# 20260801000002_add_realtime_rls). Si se deja vacío, realtime degrada a polling.
SUPABASE_JWT_SECRET="tu-jwt-secret-de-supabase"

# ─── Entorno (Vercel lo setea automáticamente) ──────────────────────
# NODE_ENV=development | production
