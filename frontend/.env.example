# En desarrollo NO necesitas esta variable (Vite usa proxy a localhost:3001).
# En producción: URL del backend deployado en Vercel TERMINANDO en /api
# (el cliente suma rutas como /auth/login a esta base).
# Ejemplo:
# VITE_API_URL="https://treeverde-api.vercel.app/api"
VITE_API_URL=

# ─── Realtime (Supabase) ───────────────────────────────────────────────
# Notificaciones y tablero en vivo vía Supabase Realtime (postgres_changes).
# Requiere las migraciones 20260801000001_add_supabase_realtime (publicación)
# y 20260801000002_add_realtime_rls (políticas RLS por userId) aplicadas, y que
# el backend tenga SUPABASE_JWT_SECRET para acuñar el token de autenticación.
# Obtén URL y anon key en: Supabase Dashboard → Project Settings → API.
# Si se dejan vacías, la app funciona sin realtime (solo polling).
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-key-publica"
